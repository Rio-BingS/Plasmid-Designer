[Unit]
Description=Plasmid Designer Backend API
After=network.target
Wants=network-online.target
# 重启限流字段属于 [Unit] 段；放在 [Service] 会被 systemd 静默忽略
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=plasmid
Group=plasmid
WorkingDirectory=/opt/plasmid-designer/src/backend

# Python 路径
Environment=PYTHONPATH=/opt/plasmid-designer/src/backend
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

# 数据目录
Environment=DATA_DIR=/opt/plasmid-designer/data
Environment=VECTORS_DIR=/opt/plasmid-designer/data/vectors
Environment=CODON_TABLES_DIR=/opt/plasmid-designer/data/codon_tables

# 从 .env 文件加载额外环境变量
EnvironmentFile=/opt/plasmid-designer/.env

# 单 worker：进程内限流器/缓存/内存镜像均按单进程设计，
# 多 worker 会导致限流与缓存计数不一致
ExecStart=/opt/plasmid-designer/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1

# 重启策略
Restart=on-failure
RestartSec=5

# 日志
SyslogIdentifier=plasmid-backend
StandardOutput=journal
StandardError=journal

# 安全限制
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
