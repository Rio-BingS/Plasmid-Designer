# Plasmid Designer 环境配置
# 安装脚本会自动生成 .env，此处仅作参考

# ========== 存储 ==========
# database: SQLite（默认）或 PostgreSQL
STORAGE_MODE=database

# ========== 数据库 ==========
# SQLite 模式（默认，零外部依赖）
# 库放在 0700 的 db/ 子目录（属主 plasmid），不要放到安装目录根下
DATABASE_URL=sqlite:////opt/plasmid-designer/db/plasmid_designer.db

# PostgreSQL 模式（取消注释并注释掉上面 SQLite 行）
# DATABASE_URL=postgresql://plasmid:YOUR_PASSWORD@localhost/plasmid_designer

# ========== Redis ==========
# 直接部署默认关闭，无需 Redis 服务
REDIS_ENABLED=false

# ========== 安全 ==========
# JWT 密钥 — 必填，无默认值；留空或填占位/过短/低熵值后端都会拒绝启动
# 生成: openssl rand -hex 32（install.sh 会自动生成）
SECRET_KEY=

# ========== 调试 ==========
DEBUG=false
# API 文档 /docs、/openapi.json：裸机 nginx 已只对本机/内网开放（终审 H-04）；
# 不需要时设为 false 彻底关闭（返回 404）
ENABLE_API_DOCS=true
# 预留项：后端目前不读取 LOG_LEVEL，日志级别固定为 INFO，改这里不生效
LOG_LEVEL=INFO

# ---- 管理员账号引导（启动时若该邮箱用户不存在则自动创建为管理员） ----
# 不设置则不创建；生产务必设置强密码（openssl rand -base64 16）
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- 邮件发送（注册邮箱验证码） ----
# console = 验证码打到后端日志（默认，零配置）；smtp = 任意邮箱 SMTP（QQ/163/Gmail 授权码）；
# resend = Resend API（免费 3000 封/月，邮箱注册无需信用卡）；brevo = Brevo API（免费 300 封/天）
MAIL_PROVIDER=console
# 发件人展示（resend 需为已验证域名下的地址；smtp 一般填 SMTP_USER 本身）
MAIL_FROM=Plasmid Designer <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# 465 端口 SSL=true；587 端口 STARTTLS 时设 false
SMTP_SSL=true
RESEND_API_KEY=
BREVO_API_KEY=

# ========== 登录会话 Cookie ==========
# 登录令牌放在 httpOnly 会话 Cookie 中。Secure 标记：auto = 按请求协议判定
# （同机 nginx 经 X-Forwarded-Proto 告知 https，配置 HTTPS 后自动置位）；
# true = 总是置位（TLS 在更外层代理终止时用）；false = 从不置位
AUTH_COOKIE_SECURE=auto

# ========== 可信反向代理 ==========
# 逗号分隔 IP/CIDR；只有来自这些对端的 X-Real-IP 才被采信为限流维度。
# 裸机部署 nginx 与后端同机，默认只信本机即可
TRUSTED_PROXIES=127.0.0.1,::1

# ========== 批量测序 read 上限 ==========
# 服务器默认：管理面板（/admin → 站点设置）未给某分组设值时生效；
# 管理员可按分组（匿名访客/普通用户/管理员）或单个账号调整，无需重启
SEQUENCING_BATCH_MAX_READS_PER_GROUP=24
SEQUENCING_BATCH_MAX_TOTAL_READS=240
# 绝对安全上限：管理员填写的值不得超过，生效值也一律按它截断（防手误拆掉保护）
SEQUENCING_BATCH_READS_PER_GROUP_HARD_MAX=384
SEQUENCING_BATCH_READS_HARD_MAX=5000
# 批次计算预算（Mbp·read = Σ 各组参考长度 bp × read 数 / 10^6）：比对前估算，
# 超出返回 413 提示拆批。默认 50 覆盖默认 read 上限的最坏情况（240 条 × 200 kb），
# 调高 read 上限后大参考批次可能先撞上这里；0 = 不限
SEQUENCING_BATCH_COMPUTE_BUDGET_MBP=50
# 批次墙钟软时限（秒）：超时后剩余分组不再比对、结论记为失败，已完成的照常返回；
# 正在比对的那一组会跑完（线程无法安全中断）。0 = 不限
SEQUENCING_BATCH_SOFT_TIMEOUT=1800

# ========== 批量测序分块上传 ==========
# 批量页把文件自动切成 ≤90 MB / ≤200 个的分块依次上传（Cloudflare 免费版单请求
# 上限 100 MB），服务器在暂存目录拼成一个批次后分析一次；批次规模由上面的
# read 上限治理，下面是批次级的体积与并发保护。
# 单批总体积上限（MB），取代单请求接口的 500 MB
SEQUENCING_BATCH_SESSION_MAX_MB=2048
# 同一账号（匿名按来源 IP）/ 全站同时进行中的上传会话数；最坏磁盘占用约为
# SESSIONS_TOTAL × SESSION_MAX_MB
SEQUENCING_BATCH_SESSIONS_PER_OWNER=2
SEQUENCING_BATCH_SESSIONS_TOTAL=16
# finalize 请求内最多等待的秒数，超时返回 202 由前端轮询结果；须低于前置代理
# 的读超时（Cloudflare 固定 100 秒）
SEQUENCING_BATCH_FINALIZE_WAIT=60
# 暂存目录，缺省 $DATA_DIR/batch_uploads（服务用户须可写；不要放 /tmp：
# systemd PrivateTmp 下重启即丢失，tmpfs 还会占内存）
# SEQUENCING_BATCH_SESSION_DIR=/opt/plasmid-designer/data/batch_uploads
# 批量整理包（ZIP，15 分钟有效）落盘目录，缺省为暂存目录下的 reports/；
# 多 worker 共享同一目录，任一 worker 都能提供下载
# SEQUENCING_BATCH_REPORT_DIR=/opt/plasmid-designer/data/batch_uploads/reports

# ========== 质粒图谱（/api/map） ==========
# 单条序列长度上限（bp）：解析/编辑重算/导出均受此限，超限返回 413
MAP_MAX_LENGTH=300000
# 图谱文件上传上限（MB，GenBank/FASTA/SnapGene .dna 或粘贴文本）
MAP_MAX_UPLOAD_MB=5
