# Build stage
FROM node:22-alpine AS builder

WORKDIR /app

# npm 镜像可覆盖：国内构建传 --build-arg NPM_REGISTRY=https://registry.npmmirror.com。
# 默认官方源——硬编码国内镜像会拖垮海外 VPS 构建
ARG NPM_REGISTRY=https://registry.npmjs.org
RUN npm config set registry ${NPM_REGISTRY}

# Copy dependency files
COPY src/frontend/package*.json ./

# Install dependencies（npm ci 严格按 lock 安装，构建可复现）
RUN npm ci

# Copy source code
COPY src/frontend/ ./

# Build production bundle
RUN npm run build

# Production stage
FROM nginx:alpine

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf

# 可信宿主机前置清单：官方镜像入口在启动 nginx 前执行 /docker-entrypoint.d/*.sh，
# 按 FRONTEND_BIND / PLASMID_GATEWAY / HOST_PROXY_ADDRS 生成 geo 片段。
# 预置空清单：绕过入口脚本直接起 nginx 时默认谁都不信（失败安全）
COPY deploy/docker/nginx-host-proxy.sh /docker-entrypoint.d/40-plasmid-host-proxy.sh
RUN chmod 755 /docker-entrypoint.d/40-plasmid-host-proxy.sh \
    && : > /etc/nginx/host-proxy.geo

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
