# Plasmid Designer 环境配置（docker compose 自动读取本文件）

# ---- 数据库 ----
DB_USER=plasmid
# 必填，无默认值：留空时 docker compose 拒绝启动。
# deploy/scripts/deploy.sh 会自动写入随机强密码；手动部署请自行生成：
#   openssl rand -hex 16
# 注意：PostgreSQL 只在数据卷首次初始化时设置密码，已有数据卷后不要再改这里
DB_PASSWORD=

# ---- Redis ----
REDIS_ENABLED=true
# 必填，无默认值（生成方式同上）；backend 的 REDIS_URL 由 compose 用同一变量拼接
REDIS_PASSWORD=

# ---- 安全 ----
# 必填。deploy.sh 首次创建 .env 时会自动写入随机值；手动部署请自行生成：
#   openssl rand -hex 32
# 留空、过短或弱值时后端拒绝启动
SECRET_KEY=
DEBUG=false
# API 文档 /docs、/redoc、/openapi.json。默认 false（返回 404）。容器 nginx 无法
# 按来源限制（宿主机转发进来的请求都来自 compose 网关），设为 true 即对所有能访问
# 前端端口的人公开；需要时请在宿主机 nginx 对 /docs、/openapi.json 加 allow/deny，
# 或只在本机用 http://localhost:${BACKEND_PORT}/docs 临时查看
ENABLE_API_DOCS=false

# ---- 日志 ----
# 预留项：后端目前不读取 LOG_LEVEL，日志级别固定为 INFO，改这里不生效
LOG_LEVEL=INFO

# ---- 端口 ----
# 前端发布端口；宿主机 80 被占用时改为 8080 等
FRONTEND_PORT=80
# 前端发布地址。默认 127.0.0.1：只供宿主机 nginx 等 TLS 前置反代（README 第九节）。
# Docker 发布的端口绕过 ufw，绑 0.0.0.0 后公网可直连明文端口、绕过前置的 HTTPS。
# 不用前置、要直接以 http://服务器IP 访问时才改为 0.0.0.0
FRONTEND_BIND=127.0.0.1
# 后端仅绑定 127.0.0.1（前端容器经 Docker 内部网络访问，公网无需暴露）；
# 宿主机 8000 被占用时改为 18000 等，只影响宿主机调试端口
BACKEND_PORT=8000

# ---- 存储 ----
# database = PostgreSQL 持久化（推荐）；memory = 进程内存（重启丢失）
STORAGE_MODE=database

# ---- CORS ----
# 前端经 nginx 同源反代 /api 时无需跨域，保持默认即可；前端另域部署时填写
# 实际来源：逗号分隔（https://a.com,https://b.com）或 JSON 数组。不要用通配 *
CORS_ORIGINS=http://localhost

# ---- 登录会话 Cookie ----
# 登录令牌放在 httpOnly 会话 Cookie 中。Secure 标记：auto = 按请求协议判定
# （可信代理的 X-Forwarded-Proto 同样采信）；true = 总是置位；false = 从不置位。
# 宿主机 nginx 终止 HTTPS、再以 http 反代到本容器（README「绑定域名 / HTTPS」）时：
# 前置须发送 X-Forwarded-Proto（容器 nginx 只对 docker 网桥/本机来源透传该头），
# auto 才能判出 https；对外只提供 HTTPS 的站点建议直接设为 true，不依赖前置配置。
# 纯 http 内网访问保持 auto（设 true 时浏览器在 http 下不回传 Cookie，无法登录）
AUTH_COOKIE_SECURE=auto

# ---- 性能 ----
# 单核小机器建议 1：多 worker 会使进程内限流/缓存配额翻倍
BACKEND_WORKERS=1

# ---- 管理员账号引导（启动时若该邮箱用户不存在则自动创建为管理员） ----
# 不设置则不创建；生产务必设置强密码（openssl rand -base64 16）
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- 邮件发送（注册邮箱验证码） ----
# console = 验证码打到后端日志（默认，零配置）；smtp = 任意邮箱 SMTP（QQ/163/Gmail 授权码）；
# resend = Resend API（免费 3000 封/月，邮箱注册无需信用卡）；brevo = Brevo API（免费 300 封/天）
MAIL_PROVIDER=console
# 发件人展示（resend 需为已验证域名下的地址；smtp 一般填 SMTP_USER 本身）
MAIL_FROM=Plasmid Designer <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# 465 端口 SSL=true；587 端口 STARTTLS 时设 false
SMTP_SSL=true
RESEND_API_KEY=
BREVO_API_KEY=

# ---- 可信反向代理（限流按真实客户端 IP 计数） ----
# 逗号分隔 IP/CIDR；只有来自这些对端的 X-Real-IP / X-Forwarded-For 才被采信。
# 默认只信前端 nginx 容器的固定地址（FRONTEND_IPV4）。不要写 172.16.0.0/12 这类
# 大网段：同网段的其它容器/主机都能伪造 X-Real-IP 换限流桶。
TRUSTED_PROXIES=127.0.0.1,::1,172.28.0.10
# compose 网络固定网段与前端容器地址（与宿主机已有网段冲突时改，四项保持一致）
PLASMID_SUBNET=172.28.0.0/24
PLASMID_GATEWAY=172.28.0.1
FRONTEND_IPV4=172.28.0.10
# 前端 nginx 采信谁转来的 X-Real-IP / X-Forwarded-For / X-Forwarded-Proto：
# auto（默认）= FRONTEND_BIND 为本机回环时信任网关 PLASMID_GATEWAY（宿主机 nginx
# 经发布端口进入的来源），FRONTEND_BIND=0.0.0.0 时谁都不信——经 docker-proxy 直连
# 的外部客户端同样显示为网关，信任它等于任何人都能伪造来源 IP 换限流桶。
# none = 谁都不信；也可写逗号分隔的单个地址（不接受网段）。对外发布端口又显式
# 信任网关会重新打开上述漏洞，宿主机前置请保持 FRONTEND_BIND=127.0.0.1
HOST_PROXY_ADDRS=auto

# ---- 批量测序 read 上限 ----
# 服务器默认：管理面板（/admin → 站点设置）未给某分组设值时生效；
# 管理员可按分组（匿名访客/普通用户/管理员）或单个账号调整，无需重启
SEQUENCING_BATCH_MAX_READS_PER_GROUP=24
SEQUENCING_BATCH_MAX_TOTAL_READS=240
# 绝对安全上限：管理员填写的值不得超过，生效值也一律按它截断（防手误拆掉保护）
SEQUENCING_BATCH_READS_PER_GROUP_HARD_MAX=384
SEQUENCING_BATCH_READS_HARD_MAX=5000
# 批次计算预算（Mbp·read = Σ 各组参考长度 bp × read 数 / 10^6）：比对前估算，
# 超出返回 413 提示拆批。默认 50 覆盖默认 read 上限的最坏情况（240 条 × 200 kb），
# 调高 read 上限后大参考批次可能先撞上这里；0 = 不限
SEQUENCING_BATCH_COMPUTE_BUDGET_MBP=50
# 批次墙钟软时限（秒）：超时后剩余分组不再比对、结论记为失败，已完成的照常返回；
# 正在比对的那一组会跑完（线程无法安全中断）。0 = 不限
SEQUENCING_BATCH_SOFT_TIMEOUT=1800

# ---- 批量测序分块上传 ----
# 批量页把文件自动切成 ≤90 MB / ≤200 个的分块依次上传（Cloudflare 免费版单请求
# 上限 100 MB），服务器在暂存目录拼成一个批次后分析一次；批次规模由上面的
# read 上限治理，下面是批次级的体积与并发保护。
# 单批总体积上限（MB），取代单请求接口的 500 MB
SEQUENCING_BATCH_SESSION_MAX_MB=2048
# 同一账号（匿名按来源 IP）/ 全站同时进行中的上传会话数；最坏磁盘占用约为
# SESSIONS_TOTAL × SESSION_MAX_MB
SEQUENCING_BATCH_SESSIONS_PER_OWNER=2
SEQUENCING_BATCH_SESSIONS_TOTAL=16
# finalize 请求内最多等待的秒数，超时返回 202 由前端轮询结果；须低于前置代理
# 的读超时（Cloudflare 固定 100 秒）
SEQUENCING_BATCH_FINALIZE_WAIT=60
# 暂存目录：compose 固定挂具名卷 batch-uploads 到 /app/batch_uploads，无需设置；
# 批量整理包（ZIP）落盘在其下 reports/，多 worker 共享（SEQUENCING_BATCH_REPORT_DIR 可改）

# ---- 质粒图谱（/api/map） ----
# 单条序列长度上限（bp）：解析/编辑重算/导出均受此限，超限返回 413
MAP_MAX_LENGTH=300000
# 图谱文件上传上限（MB，GenBank/FASTA/SnapGene .dna 或粘贴文本）
MAP_MAX_UPLOAD_MB=5
# 其余 /api/map/* 写请求（analyze、export、import）的请求体上限（MB）；调大它或
# MAP_MAX_UPLOAD_MB 时同步调大 nginx.conf 里 location ^~ /api/map/ 的 client_max_body_size
MAP_MAX_JSON_MB=16
# annotate 缺省时只对不超过该长度（bp）的序列自动注释常见元件
MAP_AUTO_ANNOTATE_MAX_BP=50000
# 单次请求自动注释比对的 DP 单元格总预算（约 1 s），用尽时余下候选跳过并告警
MAP_ANNOTATE_MAX_CELLS=60000000
# 酶切位点明细上限：单把酶 / 单份文档（cut_count 仍为完整计数，超出时 sites_truncated=true）
MAP_MAX_SITES_PER_ENZYME=500
MAP_MAX_TOTAL_SITES=60000
# 图谱文档缓存：序列化超过该字节数的文档不缓存；本进程缓存的文档总字节上限
MAP_CACHE_MAX_DOC_BYTES=1048576
MAP_CACHE_MAX_TOTAL_BYTES=67108864
# NCBI accession 导入（POST /api/map/import/ncbi，E-utilities）：联系邮箱建议填写，
# API key 可选（速率上限 3 → 10 次/秒）；留空也能用
NCBI_EMAIL=
NCBI_API_KEY=
# 单次 NCBI 导入的总时长上限（秒：排队 + 连接 + 读取）与同时进行的导入数
NCBI_TIMEOUT=30
NCBI_MAX_CONCURRENCY=4

# ---- 在线序列来源导入（/api/vectors/import/*） ----
# SnapGene 在线质粒库 / Ensembl / UniProt / Addgene；false 时后端不做任何外呼（返回 503）
ONLINE_IMPORT_ENABLED=true
# SnapGene 在线质粒库（/local）单独开关，默认 true（开启）。与上面的总开关相互独立：
# 设为 false 时 SnapGene 相关端点一律 404，Ensembl/UniProt/Addgene/NCBI 不受影响；开启后也
# 只对已登录用户开放（匿名 401），存入载体库仍需管理员。
# 已知合规风险（默认开启即视为部署方接受，商业部署请设 false）：SnapGene 网站条款禁止把站内内容存入任何
# 电子检索系统，robots.txt 明确 Disallow: /local，接口来自客户端逆向；仅建议学术/
# 非营利/政府的自用实例开启，并引用 www.snapgene.com/resources，商业用途须先获
# GraphPad Software, LLC 书面许可。
SNAPGENE_ONLINE_ENABLED=true
# 单次外呼超时（秒）、单文件体积上限（字节，整包 zip 另算）
ONLINE_TIMEOUT=25
ONLINE_MAX_BYTES=8388608
# 自建镜像/代理时才需要改（默认官方地址）
# SNAPGENE_BASE=https://www.snapgene.com/local
# ENSEMBL_BASE=https://rest.ensembl.org
# UNIPROT_BASE=https://rest.uniprot.org
# Addgene 全长序列需登录，本工具不代为登录、不绕登录墙。推荐做法：用你自己的 Addgene
# 账号在浏览器下载 .gbk/.dna，再在载体库「上传文件」导入（无需在服务器上放任何凭据）。
# 下面的会话 Cookie（形如 sessionid=...）模式**只适合单用户自托管**（部署者 = 唯一使用者 = Addgene 账号持有人）：
# 多用户/开放注册的实例里它等同共享你的 Addgene 账号（ToS 要求账号持有人对其下全部活动
# 负责），导入的序列也会对全站可见——此时后端启动会记一条告警。Cookie 只用于管理员发起的
# 导入，仅以 https 发往 addgene.org（重定向跨主机即丢弃），不写入应用数据/响应/日志；
# 但它本身就保存在本 .env 与容器/进程环境变量里（docker inspect 可见），请按密钥管理。
# 未配置时相关端点返回 403 + 合法路径指引
# ADDGENE_SESSION_COOKIE=
