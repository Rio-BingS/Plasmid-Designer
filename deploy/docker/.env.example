# Plasmid Designer 环境配置（docker compose 自动读取本文件）

# ---- 数据库 ----
DB_USER=plasmid
# 生产环境务必改为强密码（deploy.sh 会自动生成 SECRET_KEY，但 DB 密码需自行替换）
DB_PASSWORD=plasmid_secure_2026

# ---- Redis ----
REDIS_ENABLED=true
# 生产环境务必改为强密码（backend 的 REDIS_URL 由 compose 用同一变量拼接，改这里即可）
REDIS_PASSWORD=plasmid_redis_2026

# ---- 安全 ----
# deploy.sh 首次创建 .env 时会自动把下面占位符替换为随机值；手动部署请自行生成
#   openssl rand -hex 32
SECRET_KEY=change_this_in_production_use_strong_random_string
DEBUG=false

# ---- 日志 ----
LOG_LEVEL=INFO

# ---- 端口 ----
# 前端对外端口；宿主机 80 被占用时改为 8080 等
FRONTEND_PORT=80
# 后端仅绑定 127.0.0.1（前端容器经 Docker 内部网络访问，公网无需暴露）；
# 宿主机 8000 被占用时改为 18000 等，只影响宿主机调试端口
BACKEND_PORT=8000

# ---- 存储 ----
# database = PostgreSQL 持久化（推荐）；memory = 进程内存（重启丢失）
STORAGE_MODE=database

# ---- CORS ----
# 支持 "*"、逗号分隔（https://a.com,https://b.com）或 JSON 数组（["*"]）
# 生产环境建议配置具体域名而非通配
CORS_ORIGINS=*

# ---- 性能 ----
# 单核小机器建议 1：多 worker 会使进程内限流/缓存配额翻倍
BACKEND_WORKERS=1
