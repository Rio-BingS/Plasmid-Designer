FROM python:3.11-slim

WORKDIR /app

# System dependencies — curl: 健康检查 + tracy 下载。
# 注意：依赖清单必须与 requirements.backend.txt 一致，不要在此手工罗列包名
# （此前手工列表与清单脱节，缺 pyyaml 导致容器启动即崩）。
# 全部依赖均有官方 wheel，无需 gcc 等编译工具链
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r plasmid && useradd -r -g plasmid plasmid

# PyPI 镜像可覆盖：国内构建传 --build-arg PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple。
# 默认官方源——此前硬编码国内镜像，海外 VPS 构建频繁断流
ARG PIP_INDEX_URL=https://pypi.org/simple/
ENV PIP_INDEX_URL=${PIP_INDEX_URL}

# Install Python dependencies（唯一来源 = requirements.backend.txt）
COPY deploy/docker/requirements.backend.txt ./requirements.txt
RUN pip install --no-cache-dir --timeout=120 --retries=5 -r requirements.txt

# biopython：Sanger 测序分析（ab1 解析 + 序列比对）。其余 numpy/pandas/scipy/
# matplotlib/primer3-py/pydna 等后端代码均未 import，不再安装（拖慢构建且徒增失败面）
RUN pip install --no-cache-dir --timeout=300 --retries=5 "biopython>=1.81"

# Tracy（Sanger trace basecalling/比对/解卷积引擎，测序分析可选加速组件）
# 下载预编译二进制；失败不阻断构建（管线会自动降级为内置实现）
ARG TRACY_VERSION=v0.9.1
RUN curl -fsSL -o /usr/local/bin/tracy       "https://github.com/gear-genomics/tracy/releases/download/${TRACY_VERSION}/tracy-${TRACY_VERSION}-linux-amd64"       && chmod +x /usr/local/bin/tracy || echo "WARN: tracy download failed, Sanger deconvolution disabled"

# Copy application code
COPY src/backend/ ./backend/
COPY data/ ./data/

# Set permissions
RUN chown -R plasmid:plasmid /app

# Python path: backend/ is the package root (contains app/ and core/)
ENV PYTHONPATH=/app/backend
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DATA_DIR=/app/data
ENV VECTORS_DIR=/app/data/vectors
ENV CODON_TABLES_DIR=/app/data/codon_tables

# Switch to non-root user
USER plasmid

EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Start command — shell 形式以在容器启动时读取 BACKEND_WORKERS（docker-compose.yml 已注入）。
# 单核小机器建议单 worker：多 worker 会使进程内限流/缓存配额翻倍，
# memory 模式下批量进度查询可能落到另一 worker 返回 404
CMD uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers "${BACKEND_WORKERS:-1}"
