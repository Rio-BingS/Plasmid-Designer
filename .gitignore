# 批量测序分块上传暂存（运行期生成）
data/batch_uploads/

# 图谱元件库重建脚本的 GenBank 下载缓存（scripts/build_feature_library.py）
.feature-library-cache/

# SQLite WAL/SHM 伴生文件（*.db 只覆盖主库文件）
*.db-shm
*.db-wal

# 备份产物（backup.sh 默认输出到 data/backups/，含全库明文数据，严禁入库）
data/backups/
work/

# 真实测序数据（含脱敏件）一律不入库（2026-11-21 政策，W16 入库决策废止）：
# 本地副本放 tests/data/real_ab1/（缺数据时回归测试自动 skip，整目录忽略
# ——数据不论什么格式放对地方都进不来），母本在仓库外
# ../plasmid-designer V/real_ab1_subset_master/
tests/data/real_ab1/
# 测序交付场景专属格式全局忽略：数据文件哪怕被复制到别的路径，add 阶段
# 就挡住（守卫 scripts/check_real_data_absence.py 的路径规则 + ABIF 文件头
# 嗅探在推送/CI 环节再拦，改名也躲不过）。清单 = 仓库零使用的测序格式
# （2026-11-22 全量盘点）：AB 系原始/导出、Sanger 文本序列、Chromas、
# Phred、SnapGene、交付压缩包、交付清单/报告文档。
# sanger_bench 的 310/3100/3730.ab1 是 Biopython 公开测试集，已在跟踪中，
# gitignore 不作用于已跟踪文件，无需豁免；将来如需某格式白名单文件，
# 用 `!路径` 豁免并在守卫 SUFFIX_ALLOWLIST_DIRS 登记说明，不要删规则
*.ab1
*.abi
*.ab
*.dna
*.scf
*.ced
*.seq
*.chromas
*.phd*
*.zip
*.7z
*.rar
*.xlsx
*.xls
*.pdf
# fasta 属受限格式：真实序列数据的常见交付形态之一，默认忽略；
# 仅 tests/fixtures/ 的合成 fixture 合法（tracy allele 两件已跟踪，
# gitignore 不作用于已跟踪文件；新增 fixture 用 `!tests/fixtures/...`
# 豁免并确认守卫 FASTA_ALLOWED_DIRS 允许其路径）。FASTQ/.bg 及一切
# 其它格式交给守卫的扩展名白名单准入（ALLOWED_EXTENSIONS）——白名单
# 外格式 commit/push/CI 三处全拦，枚举不完就反转成准入制
*.fasta
