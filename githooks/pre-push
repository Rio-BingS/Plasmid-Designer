#!/bin/sh
# 真实数据防推送守卫（2026-11-21 政策，docs/KNOWN_ISSUES.md 约束第 23 条）。
# 推送前逐新提交做路径检查 + 对 tip 树做内容检查，违规即阻断本次推送。
# 启用：python scripts/setup_hooks.py（AGENTS.md「新克隆/换机器初始化」步骤）。
# 事后兜底：.github/workflows/guard.yml 在远端对所有推送再跑一遍守卫。

zero=0000000000000000000000000000000000000000
cd "$(git rev-parse --show-toplevel)" || exit 1
guard="python scripts/check_real_data_absence.py"
fail=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue    # 删除远端 ref，无内容可查
    if [ "$remote_sha" = "$zero" ]; then
        # 新远端分支：新提交 = 不在其它远端分支上的提交
        new=$(git rev-list "$local_sha" --not --remotes)
    else
        new=$(git rev-list "$remote_sha..$local_sha")
    fi
    # 逐新提交树做路径检查（上限 100，超出只查 tip——历史级清洗属
    # filter-repo 范畴，钩子不该在万级提交的重写推送上跑半小时）
    trees=""
    i=0
    over=0
    for c in $new; do
        i=$((i + 1))
        if [ $i -gt 100 ]; then
            over=1
            break
        fi
        trees="$trees $c"
    done
    [ $over -eq 1 ] && echo "pre-push 守卫：新提交超 100 个，只查 tip + 前 100 提交路径" >&2
    # tip 放第一棵：内容规则只查 tip（守卫 --tree 语义）
    $guard --tree "$local_sha"$trees || fail=1
done

if [ "$fail" -ne 0 ]; then
    echo "" >&2
    echo "✗ 真实数据防推送守卫拦截：以上提交含真实测序数据/衍生信息，推送已取消。" >&2
    echo "  政策与白名单：scripts/check_real_data_absence.py、" >&2
    echo "  docs/KNOWN_ISSUES.md 防回潮约束第 23 条。" >&2
    exit 1
fi
exit 0
